class Node {
    int data;
    Node prev;
    Node next;

    Node(int data) {
        this.data = data;
    }
}

public class Main {
    Node head;

    // Insert at end
    void insert(int data) {
        Node newNode = new Node(data);

        if (head == null) {
            head = newNode;
            return;
        }

        Node temp = head;

        while (temp.next != null) {
            temp = temp.next;
        }

        temp.next = newNode;
        newNode.prev = temp;
    }

    // Search
    void search(int value) {
        Node temp = head;
        int position = 1;

        while (temp != null) {
            if (temp.data == value) {
                System.out.println(value + " found at position " + position);
                return;
            }

            temp = temp.next;
            position++;
        }

        System.out.println(value + " not found");
    }

    public static void main(String[] args) {
        Main list = new Main();

        list.insert(10);
        list.insert(20);
        list.insert(30);
        list.insert(40);

        list.search(30);
        list.search(50);
    }
}

